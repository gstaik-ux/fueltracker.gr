# Postgres connection string (Supabase: Project Settings -> Database -> Connect -> Connection string -> URI, "Transaction" pooler mode)
DATABASE_URL=postgres://user:password@host:5432/postgres

# Any long random string - signs the admin login session. Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# Your admin password - only needed to view the full vehicle list at "/".
# Each vehicle's own /v/<slug> link (what the NFC tags use) never asks for this.
ADMIN_PASSWORD=2802
